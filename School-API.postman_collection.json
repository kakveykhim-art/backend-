{
  "info": {
    "name": "School API (read-only)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "All classes",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/classes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "classes"
          ]
        }
      }
    },
    {
      "name": "Class by id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/classes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "classes",
            "1"
          ]
        }
      }
    },
    {
      "name": "Students in class",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/classes/1/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "classes",
            "1",
            "students"
          ]
        }
      }
    },
    {
      "name": "Class ranking",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/classes/1/ranking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "classes",
            "1",
            "ranking"
          ]
        }
      }
    },
    {
      "name": "All subjects",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/subjects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "subjects"
          ]
        }
      }
    },
    {
      "name": "Subject by id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/subjects/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "subjects",
            "1"
          ]
        }
      }
    },
    {
      "name": "All trainers",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/trainers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trainers"
          ]
        }
      }
    },
    {
      "name": "Trainer by id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/trainers/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trainers",
            "1"
          ]
        }
      }
    },
    {
      "name": "Students (paged)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Students search",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students?search=Student 01&gender=F",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ],
          "query": [
            {
              "key": "search",
              "value": "Student 01"
            },
            {
              "key": "gender",
              "value": "F"
            }
          ]
        }
      }
    },
    {
      "name": "Student by id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        }
      }
    },
    {
      "name": "Student scores",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/1/scores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1",
            "scores"
          ]
        }
      }
    },
    {
      "name": "Scores (filtered)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/scores?class_id=1&sub_id=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores"
          ],
          "query": [
            {
              "key": "class_id",
              "value": "1"
            },
            {
              "key": "sub_id",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Score by id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/scores/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            "1"
          ]
        }
      }
    },
    {
      "name": "Subject averages",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/reports/subject-average",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reports",
            "subject-average"
          ]
        }
      }
    },
    {
      "name": "Write blocked (expect 405)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    }
  ]
}